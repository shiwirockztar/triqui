{
  "name": "Python 3.11 Codespace",
  "image": "mcr.microsoft.com/vscode/devcontainers/python:0-3.11",
  "forwardPorts": [8000],
  "postCreateCommand": "pip install -r requirements.txt",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python"
      ]
    }
  },
  "remoteUser": "vscode"
}
